# Copia como ".env" en la raiz del proyecto (junto a docker-compose.yml).
JWT_SECRET=genera-una-cadena-larga-aleatoria
DB_ADMIN_PASSWORD=clave-del-postgres-del-contenedor
DB_APP_PASSWORD=clave-del-usuario-de-la-app
DB_NAME=refurbiz
# Con HTTPS (Caddy + dominio) deja true; si pruebas por http://IP:3000 pon false
COOKIE_SECURE=true
DOMAIN=inventario.tudominio.com
APP_PORT=3000
