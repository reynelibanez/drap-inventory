{
  "name": "refurbiz-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "DRAP Inventory — inventario, testeo, ubicaciones y ventas de equipos reacondicionados (multiempresa, es/en)",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:setup": "npm run db:setup -w server",
    "db:seed-demo": "npm run db:seed-demo -w server",
    "create-admin": "npm run create-admin -w server",
    "stripe:setup": "npm run stripe:setup -w server",
    "test": "npm run test -w server",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "setup-env": "node scripts/setup-env.mjs",
    "release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}