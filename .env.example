# Copia este archivo como ".env" (o ejecuta: node scripts/setup-env.mjs) y ajusta los valores.
NODE_ENV=production
PORT=3000
# Cadena larga y aleatoria. Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# true cuando se sirve por HTTPS (VPS con dominio); false en la PC con http://localhost
COOKIE_SECURE=false

DB_HOST=localhost
DB_PORT=5432
# Nombre de la base de datos (letras, numeros y _). Se crea al instalar; si lo cambias despues se creara otra base, nueva y vacia.
DB_NAME=drap_inventory
# Administrador de PostgreSQL: solo lo usan "db:setup" y "db:migrate"
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
# Usuario de la aplicacion (lo crea db:setup, SIN privilegios de superusuario para que el aislamiento por empresa aplique)
DB_APP_USER=drap_inventory_app
DB_APP_PASSWORD=cambia-esta-clave

# Opcionales
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=14
# DB_SSL=false
# CORS_ORIGIN=            (solo si el front corre en otro dominio)

# Además de PORT (http), el sistema se sirve por HTTPS en el puerto 443 (el estándar; no hace
# falta escribirlo en la dirección) con un certificado propio de esta PC (generado solo, en
# data/tls) — lo exige el navegador para notificaciones push fuera de "localhost", p. ej. desde
# el celular en la misma red. Activo por defecto; para apagarlo o cambiar el puerto:
# HTTPS_ENABLED=false
# HTTPS_PORT=443

# Notificaciones push: las claves VAPID se crean solas y se guardan en la base de datos (no hace falta configurarlas).
# Solo cambia el contacto que ven los servicios de notificaciones (un correo tuyo):
# VAPID_SUBJECT=mailto:tu-correo@tudominio.com
# Otros servicios push permitidos aparte de Google, Mozilla, Apple y Microsoft (separados por coma):
# PUSH_ALLOWED_HOSTS=

# Suscripciones y pagos (Stripe). Sin estas claves, el sistema funciona igual pero nadie puede pagar
# online: el admin de plataforma tiene que asignar los planes a mano. Las claves se sacan de
# https://dashboard.stripe.com/apikeys (usa las que empiezan "sk_test_"/"pk_test_" mientras pruebas).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Se obtiene al correr "npm run stripe:setup -- --webhook-url https://tu-dominio/api/webhooks/stripe"
# (o a mano en Stripe -> Developers -> Webhooks). Sin esto, los pagos no actualizan el plan solos.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Dirección pública de la app (a donde vuelve Stripe después de pagar). Sin barra al final.
# APP_URL=http://localhost:3000
